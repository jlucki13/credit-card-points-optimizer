{
  "name": "credit-card-points-optimizer",
  "version": "0.1.0",
  "private": true,
  "description": "Personal app that tracks Chase UR / Amex MR / Capital One miles balances and recommends the highest-value redemption for a specific trip.",
  "type": "module",
  "workspaces": [
    "server",
    "client"
  ],
  "scripts": {
    "dev": "concurrently -n server,client -c blue,green \"npm:dev:server\" \"npm:dev:client\"",
    "dev:server": "npm run dev --workspace=server",
    "dev:client": "npm run dev --workspace=client",
    "build": "npm run build --workspace=client",
    "start": "npm run start --workspace=server",
    "test": "npm test --workspace=server"
  },
  "devDependencies": {
    "concurrently": "^9.1.2"
  }
}
